{
  "name": "sos-web",
  "private": true,
  "version": "0.1.0",
  "license": "AGPL-3.0-only",
  "type": "module",
  "packageManager": "pnpm@10.30.3",
  "engines": { "node": ">=22" },
  "scripts": {
    "dev": "vite",
    "build": "node scripts/check-vendor.mjs && tsc --noEmit && vite build",
    "preview": "vite preview",
    "test": "vitest run",
    "test:watch": "vitest",
    "e2e": "playwright test",
    "e2e:dev": "SOS_E2E=dev playwright test",
    "lint": "eslint . && tsc --noEmit",
    "vendor": "bash scripts/vendor-pdfjs.sh",
    "welcome": "node scripts/make-welcome.mjs",
    "icons": "node scripts/make-icons.mjs"
  },
  "dependencies": {
    "epubjs": "0.3.93",
    "maplibre-gl": "5.24.0",
    "pmtiles": "4.5.0",
    "proj4": "2.22.0",
    "qrcode": "1.5.4",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "react-router": "7.18.3",
    "simple-keyboard": "3.8.183"
  },
  "devDependencies": {
    "@eslint/js": "9.39.5",
    "@playwright/test": "1.62.1",
    "@testing-library/jest-dom": "7.0.1",
    "@testing-library/react": "16.3.3",
    "@testing-library/user-event": "14.6.7",
    "@types/jsdom": "30.0.0",
    "@types/node": "22.20.1",
    "@types/qrcode": "1.5.6",
    "@types/react": "19.2.18",
    "@types/react-dom": "19.2.7",
    "@vitejs/plugin-react": "5.2.0",
    "eslint": "9.39.5",
    "eslint-plugin-react-hooks": "7.1.1",
    "globals": "17.12.0",
    "jsdom": "26.1.0",
    "pdfjs-dist": "6.3.289",
    "typescript": "5.9.3",
    "typescript-eslint": "8.69.0",
    "vite": "6.4.3",
    "vitest": "3.2.7"
  }
}
