[Unit]
Description=Operation SOS kiosk (cage and Chromium on the touchscreen)
After=systemd-user-sessions.service caddy.service sos-api.service getty@tty1.service
Wants=caddy.service sos-api.service
Conflicts=getty@tty1.service
# An unattended box has nobody to `systemctl reset-failed`: never park this unit in `failed` after a burst
# of restarts (the default is 5 starts in 10 s). Restart=always, because on-failure does not restart
# after SIGTERM from an out-of-memory daemon or a stray kill, only after a crash.
StartLimitIntervalSec=0

[Service]
Type=simple
User=sos
Group=sos
# Owns tty1 itself: a PAM login session on the console, no getty autologin (spec section 5).
PAMName=login
TTYPath=/dev/tty1
TTYReset=yes
TTYVHangup=yes
TTYVTDisallocate=yes
StandardInput=tty-fail
StandardOutput=journal
StandardError=journal
UtmpIdentifier=tty1
UtmpMode=user
Environment=XDG_SESSION_TYPE=wayland
# Waits up to 60 s for http://localhost/api/status; the wrapper starts Chromium on /starting either way.
ExecStartPre=/usr/local/bin/sos-kiosk-app --wait-for-api
ExecStart=/usr/bin/cage -- /usr/local/bin/sos-kiosk-app
Restart=always
RestartSec=3

[Install]
WantedBy=graphical.target
