[Unit]
Description=Operation SOS embedding model (llama-server, semantic search)
Documentation=https://github.com/ggml-org/llama.cpp/tree/master/tools/server
After=network.target
# Always on, unlike the assistant: a 37 MB model that answers a query in 25 ms and idles at nothing,
# so search can ask it what a question means. sos/embeddings.py; the model is the bge-small-en-v1.5
# manifest item. If the model is absent the unit fails quietly and search is the keyword search alone.
ConditionPathExists=/srv/sos/core/models/embed/bge-small-en-v1.5-q8_0.gguf

[Service]
Type=simple
User=sos
Group=sos
ExecStart=/usr/local/bin/llama-server -m /srv/sos/core/models/embed/bge-small-en-v1.5-q8_0.gguf --embedding --pooling cls -c 512 -ub 512 -b 512 --host 127.0.0.1 --port 8091 -t 2 --no-webui
Restart=on-failure
RestartSec=5
Nice=5
MemoryMax=600M
OOMScoreAdjust=300
TimeoutStopSec=10

[Install]
WantedBy=multi-user.target
