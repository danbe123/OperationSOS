{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://operation-sos.invalid/kits.schema.json",
  "title": "Operation SOS kit",
  "description": "playbooks/kits/<slug>.yaml: a tiered, tickable list of things to have. Rules in playbooks/README.md.",
  "type": "object",
  "required": ["id", "title", "icon", "order", "summary", "sources", "tiers", "items"],
  "additionalProperties": false,
  "properties": {
    "id": {"type": "string", "pattern": "^[a-z0-9][a-z0-9-]*$"},
    "title": {"type": "string", "minLength": 1},
    "icon": {"type": "string", "minLength": 1},
    "order": {"type": "integer", "minimum": 0},
    "summary": {"type": "string", "minLength": 20, "maxLength": 160},
    "intro": {"type": "string"},
    "sources": {"type": "array", "minItems": 1, "items": {"$ref": "#/$defs/source"}},
    "relevant_when": {
      "type": "object", "additionalProperties": false, "minProperties": 1,
      "properties": {
        "age_under": {"type": "integer", "minimum": 1},
        "needs_any": {"type": "array", "minItems": 1, "items": {"type": "string", "minLength": 1}}
      }
    },
    "tiers": {
      "type": "object", "additionalProperties": false, "required": ["basic", "serious", "full"],
      "properties": {"basic": {"$ref": "#/$defs/tier"}, "serious": {"$ref": "#/$defs/tier"}, "full": {"$ref": "#/$defs/tier"}}
    },
    "items": {"type": "array", "minItems": 1, "items": {"$ref": "#/$defs/item"}}
  },
  "$defs": {
    "source": {
      "type": "object", "required": ["title"], "additionalProperties": false,
      "properties": {
        "title": {"type": "string", "minLength": 1},
        "doc": {"type": "string", "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]*$"},
        "kiwix": {"type": "string", "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]*/.+$"},
        "url": {"type": "string", "pattern": "^https?://"},
        "as_at": {"type": "string", "pattern": "^[0-9]{4}-[0-9]{2}(-[0-9]{2})?$"}
      }
    },
    "tier": {
      "type": "object", "required": ["title", "days", "why"], "additionalProperties": false,
      "properties": {"title": {"type": "string", "minLength": 1}, "days": {"type": "integer", "minimum": 1}, "why": {"type": "string", "minLength": 1}}
    },
    "item": {
      "type": "object", "required": ["id", "tier", "name"], "additionalProperties": false,
      "properties": {
        "id": {"type": "string", "pattern": "^[a-z0-9]+(-[a-z0-9]+)*$"},
        "tier": {"enum": ["basic", "serious", "full"]},
        "name": {"type": "string", "minLength": 1, "maxLength": 120},
        "qty": {
          "type": "object", "required": ["amount"], "additionalProperties": false,
          "properties": {
            "amount": {"type": "number", "exclusiveMinimum": 0},
            "unit": {"type": "string"},
            "per": {"enum": ["person", "person-day", "household"]}
          }
        },
        "stock": {
          "type": "object", "required": ["category", "unit"], "additionalProperties": false,
          "properties": {"category": {"enum": ["water", "food", "fuel", "medicine", "other"]}, "unit": {"type": "string", "minLength": 1}}
        },
        "why": {"type": "string"},
        "note": {"type": "string"},
        "link": {"type": "string", "pattern": "^(module|page|card|playbook|doc|kiwix|map):.+$"}
      }
    }
  }
}
