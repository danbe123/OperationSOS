{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Operation SOS situation rules",
  "type": "object",
  "required": ["rules"],
  "properties": {
    "rules": { "type": "array", "items": { "$ref": "#/$defs/rule" } },
    "bulletins": { "type": "array", "items": { "$ref": "#/$defs/bulletin" } }
  },
  "$defs": {
    "state": { "enum": ["working", "degraded", "off"] },
    "when": {
      "type": "object",
      "description": "Every key must match. Condition keys take a state or a list of states; scenario takes a slug or 'any'; dark and drill take booleans; phones takes off (no route) or working (some route).",
      "additionalProperties": false,
      "properties": {
        "power": { "$ref": "#/$defs/stateOrList" }, "water": { "$ref": "#/$defs/stateOrList" }, "mobile": { "$ref": "#/$defs/stateOrList" },
        "landline": { "$ref": "#/$defs/stateOrList" }, "internet": { "$ref": "#/$defs/stateOrList" }, "gas": { "$ref": "#/$defs/stateOrList" },
        "heating": { "$ref": "#/$defs/stateOrList" }, "roads": { "$ref": "#/$defs/stateOrList" }, "shops": { "$ref": "#/$defs/stateOrList" },
        "sewage": { "$ref": "#/$defs/stateOrList" },
        "phones": { "enum": ["off", "working"] },
        "scenario": { "type": "string" }, "dark": { "type": "boolean" }, "drill": { "type": "boolean" },
        "season": { "enum": ["winter", "summer"] }
      }
    },
    "stateOrList": { "oneOf": [{ "$ref": "#/$defs/state" }, { "type": "array", "items": { "$ref": "#/$defs/state" }, "minItems": 1 }] },
    "terms": { "oneOf": [{ "type": "string", "minLength": 1 }, { "type": "array", "items": { "type": "string", "minLength": 1 }, "minItems": 1 }] },
    "duration": { "type": "string", "pattern": "^\\d+(\\.\\d+)?[mhd]$", "description": "Minutes, hours or days: 30m, 4h, 2d" },
    "link": { "type": "string", "pattern": "^(playbook|module|page|card|doc|map|kiwix):" },
    "rule": {
      "type": "object",
      "required": ["id", "kind", "when", "source"],
      "properties": {
        "id": { "type": "string", "pattern": "^[a-z0-9-]+$" },
        "kind": { "enum": ["implication", "consequence", "task", "mode", "reading"] },
        "when": { "$ref": "#/$defs/when" },
        "source": { "$ref": "#/$defs/link", "description": "Where the timing or advice comes from" },
        "why": { "type": "string" },
        "expect": { "type": "object", "required": ["condition", "state", "after"], "additionalProperties": false,
          "properties": { "condition": { "type": "string" }, "state": { "$ref": "#/$defs/state" }, "after": { "$ref": "#/$defs/duration" }, "where": { "type": "string" } } },
        "confidence": { "type": "number", "minimum": 0, "maximum": 1 },
        "title": { "type": "string" },
        "after": { "$ref": "#/$defs/duration" },
        "severity": { "enum": ["info", "warn", "danger"] },
        "link": { "$ref": "#/$defs/link" },
        "needs": { "$ref": "#/$defs/terms", "description": "One term or a list of them, matched against the needs and medications of whoever `who` names (case-insensitive substring); one item per matching person, with {name}, {address} and {at_address} available in the title. '*' means anyone with something recorded, 'any' means everyone on the list" },
        "skills": { "$ref": "#/$defs/terms", "description": "Reading rules only: one term or a list of them, matched against a neighbour's skills; each match is listed as '<name> is a nurse'" },
        "who": { "enum": ["household", "neighbours"], "description": "Which register `needs` and `skills` read: the household register (the default) or the street list" },
        "stock": { "type": "object", "additionalProperties": false, "required": ["category"],
          "properties": { "category": { "enum": ["water", "food", "fuel", "medicine", "other"] }, "days_lt": { "type": "number" }, "missing": { "type": "boolean" } } },
        "bucket": { "enum": ["now", "hour", "today", "week"] },
        "until": { "$ref": "#/$defs/when" },
        "set": { "type": "object", "additionalProperties": false,
          "properties": { "theme": { "enum": ["vault", "field", "blackout"] }, "dim": { "type": "boolean" }, "calls": { "enum": ["shown", "hidden"] }, "map_first": { "type": "boolean" }, "board": { "type": "boolean" } } },
        "open": { "type": "array", "items": { "$ref": "#/$defs/link" }, "minItems": 1 }
      },
      "allOf": [
        { "if": { "properties": { "kind": { "const": "implication" } } }, "then": { "required": ["expect", "confidence"] } },
        { "if": { "properties": { "kind": { "const": "consequence" } } }, "then": { "required": ["title", "after", "severity"] } },
        { "if": { "properties": { "kind": { "const": "task" } } }, "then": { "required": ["title", "bucket"] } },
        { "if": { "properties": { "kind": { "const": "mode" } } }, "then": { "required": ["set"] } },
        { "if": { "properties": { "kind": { "const": "reading" } } },
          "then": { "anyOf": [{ "required": ["open"] }, { "required": ["skills"] }] } },
        { "if": { "properties": { "skills": true }, "required": ["skills"] },
          "then": { "properties": { "kind": { "const": "reading" }, "who": { "const": "neighbours" } }, "required": ["who"] } }
      ]
    },
    "bulletin": {
      "type": "object", "required": ["station", "times"], "additionalProperties": false,
      "properties": { "station": { "type": "string" }, "frequency": { "type": "string" }, "times": { "type": "array", "items": { "type": "string", "pattern": "^\\d\\d:\\d\\d$" } }, "note": { "type": "string" }, "record_hz": { "type": "integer", "minimum": 24000000, "maximum": 1766000000, "description": "The FM carrier in hertz. Inside an RTL-SDR's tuning range (24 MHz to 1.766 GHz), so long and medium wave cannot be given one." }, "recordable": { "type": "boolean", "description": "false when the dongle cannot receive this station at all (long or medium wave)" } }
    }
  }
}
